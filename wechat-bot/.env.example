# ── Anthropic (Claude) —— 机器人大脑 ──────────────────────────────
# 必填:Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...
# 可选:代理地址(如 LiteLLM 的 Anthropic 兼容端点);留空用官方默认
ANTHROPIC_BASE_URL=
# 可选:模型。默认用 Haiku(快、便宜,适合审批指令);要更强可换 Opus
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── PunkRecord 后端 ───────────────────────────────────────────────
# 后端 REST 地址(开发 15085;生产改 http://127.0.0.1:9086/api/v1)
PUNKRECORD_API=http://127.0.0.1:15085/api/v1
# 必填:机器人代表哪个用户操作 —— 该用户在 punkrecord「MCP」页创建的 pat_ agent token
PUNKRECORD_AGENT_TOKEN=pat_...

# ── 推送服务(punkrecord 把待办通知 POST 到这里)───────────────────
BOT_PUSH_PORT=15090
# 可选:推送接口共享密钥;若设置,punkrecord 的 WECHAT_MSG_SERVICE_API_KEY 要填同一个值
BOT_PUSH_API_KEY=
