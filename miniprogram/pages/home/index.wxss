.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.header-card {
  margin-top: 6rpx;
  background: linear-gradient(135deg, #6366f1, #4f46e5 75%);
  color: #ffffff;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.hero-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
}
.header-card .muted {
  color: rgba(255, 255, 255, 0.85);
}
.metric {
  text-align: center;
  border: 1rpx solid #e2e8f0;
}
.metric-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1e293b;
}
.metric-label {
  color: #64748b;
  font-size: 22rpx;
  margin-top: 8rpx;
}
.metric-todo .metric-num { color: #1d4ed8; }
.metric-project .metric-num { color: #0f766e; }
.metric-txn .metric-num { color: #6366f1; }
.metric-leave .metric-num { color: #dc2626; }
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.quick-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 18rpx 14rpx;
}
.quick-title {
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 600;
}
.quick-desc {
  color: #64748b;
  font-size: 20rpx;
  margin-top: 8rpx;
  line-height: 1.35;
}
