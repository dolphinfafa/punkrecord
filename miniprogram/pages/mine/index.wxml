<view class="container">
  <view class="card profile">
    <view class="avatar">{{initial}}</view>
    <view>
      <view class="name">{{name || '访客'}}</view>
      <view class="muted">{{username || '未登录'}}</view>
    </view>
  </view>

  <view class="card menu" bindtap="goContract">合同模块</view>
  <view class="card menu" bindtap="goIAM">组织成员模块</view>
  <button class="primary-btn" bindtap="logout">退出登录</button>
</view>
