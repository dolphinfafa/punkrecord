<view class="container login-page">
  <view class="hero">
    <view class="brand">PunkRecord</view>
    <view class="subtitle">企业工作台小程序</view>
  </view>

  <view class="card login-card">
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameChange" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordChange" />
    </view>
    <button class="primary-btn" loading="{{loading}}" bindtap="onLogin">登录</button>
  </view>
</view>
