.tab-scroll { white-space: nowrap; }
.tab-row {
  display: flex;
  gap: 12rpx;
}
.search-card {
  display: flex;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
}
.search-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #475569;
}
.todo-item { margin-bottom: 14rpx; }
.todo-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  max-width: 470rpx;
  line-height: 1.35;
}
.badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
}
.badge.open { background: #e2e8f0; color: #334155; }
.badge.in_progress { background: #dbeafe; color: #1d4ed8; }
.badge.pending_review { background: #ffedd5; color: #c2410c; }
.badge.submitted { background: #fef3c7; color: #a16207; }
.badge.done { background: #dcfce7; color: #166534; }
.badge.blocked { background: #fee2e2; color: #991b1b; }
.todo-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #475569;
  line-height: 1.45;
}
.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}
.action-btn {
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  color: #334155;
  background: #ffffff;
  padding: 0 20rpx;
}
.action-btn-main {
  background: #6366f1;
  color: #ffffff;
  border-color: #6366f1;
}
.action-btn-warn {
  background: #fff7ed;
  color: #c2410c;
  border-color: #fdba74;
}
