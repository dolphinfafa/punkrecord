<view class="container">
  <view class="card">
    <view class="title">组织成员</view>
    <view class="muted">IAM 模块移动端快照视图。</view>
  </view>
  <block wx:if="{{users.length}}">
    <view class="card" wx:for="{{users}}" wx:key="id">
      <view class="row">
        <text class="name">{{item.nameText}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="muted">{{item.emailText}}</view>
    </view>
  </block>
  <view class="card" wx:else><view class="muted">暂无成员数据。</view></view>
</view>
