<view class="container">
  <view class="card">
    <view class="title">合同列表</view>
    <view class="muted">当前为移动端只读视图。</view>
  </view>
  <block wx:if="{{contracts.length}}">
    <view class="card" wx:for="{{contracts}}" wx:key="id">
      <view class="row">
        <text class="name">{{item.titleText}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="muted">金额：{{item.amountText}}</view>
    </view>
  </block>
  <view class="card" wx:else><view class="muted">暂无合同数据。</view></view>
</view>
