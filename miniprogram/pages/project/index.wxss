.tab-scroll { white-space: nowrap; }

.tab-row {
  display: flex;
  gap: 12rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.stat-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
  text-align: center;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.text-primary { color: #1d4ed8; }
.text-warn { color: #b45309; }
.text-success { color: #166534; }

.search-card {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.search-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #475569;
}

.project-item {
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  align-items: flex-start;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  max-width: 450rpx;
  line-height: 1.35;
}

.badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
}

.badge.active { background: #dbeafe; color: #1d4ed8; }
.badge.paused { background: #fee2e2; color: #b91c1c; }
.badge.draft { background: #ede9fe; color: #6d28d9; }
.badge.closed { background: #dcfce7; color: #166534; }
.badge.cancelled { background: #f1f5f9; color: #475569; }

.progress-wrap {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6366f1, #4f46e5);
}

.progress-text {
  font-size: 22rpx;
  color: #475569;
}

.action-row {
  margin-top: 16rpx;
}

.action-btn {
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  color: #334155;
  background: #ffffff;
  padding: 0 20rpx;
}

.action-btn-main {
  background: #6366f1;
  color: #ffffff;
  border-color: #6366f1;
}
