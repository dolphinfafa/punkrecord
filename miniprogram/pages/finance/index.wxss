.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.summary-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
}
.summary-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.summary-num.income { color: #15803d; }
.summary-num.expense { color: #b91c1c; }
.tab-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.tab-item {
  text-align: center;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: #475569;
}
.tab-item-active {
  background: #6366f1;
  color: #ffffff;
  border-color: #6366f1;
}
.mini { font-size: 28rpx; margin-bottom: 10rpx; }
.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.name { font-size: 26rpx; max-width: 500rpx; }
.amt { font-size: 26rpx; font-weight: 700; color: #0f172a; }
.amt.in { color: #15803d; }
.amt.out { color: #b91c1c; }
.txn { padding: 10rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.txn:last-child { border-bottom: none; }
