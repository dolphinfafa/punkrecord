page {
  background: #f8fafc;
  color: #1e293b;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.section-gap {
  margin-top: 16rpx;
}

.section-head {
  margin: 6rpx 4rpx 14rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.chip {
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #475569;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  box-sizing: border-box;
}

.chip-active {
  color: #ffffff;
  background: #6366f1;
  border-color: #6366f1;
}

.primary-btn {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
}
